# ==============================================================================
# CONFIGURACIÓN DE ENTORNO - PLANTILLA BASE (.env.example)
# Copiar a .env y completar credenciales locales
# ==============================================================================
NODE_ENV=development
PORT=8081

# ===============================================
# BASE DE DATOS Y AUTENTICACIÓN
# ===============================================
DATABASE_URL=mongodb://localhost:27017/cursala_local
JWT_SECRET=tu-secreto-jwt-local

# ===============================================
# MERCADOPAGO (MOCK LOCAL)
# Regla: Usar credenciales TEST de Sandbox
# ===============================================
MERCADOPAGO_MODE=development
MERCADOPAGO_ACCESS_TOKEN=TEST-placeholder-local-dev
MERCADOPAGO_PUBLIC_KEY=TEST-public-key-local
WEBHOOK_URL=http://localhost:8081/api/v1/payments/webhook
FRONTEND_URL=http://localhost:4200
BACKEND_URL=http://localhost:8081

# ===============================================
# SERVICIO DE EMAILS (Transaccional)
# ===============================================
# En dev local: true (no toca internet ni el mailserver real)
EMAIL_USE_ETHEREAL=true
ADMIN_NOTIFICATION_EMAIL=luis.varela@cursala.com.ar
EMAIL_FROM=info@cursala.com.ar
EMAIL_PASSWORD=tu-contraseña-smtp
EMAIL_HOST=mail.cursala.com.ar
EMAIL_PORT=587

# ===============================================
# CERTIFICADOS
# Regla: Clave simétrica de 256 bits en base64
# ===============================================
USE_HTML_CERTIFICATE=false
CERTIFICATE_ENCRYPTION_KEY=clave-base64-de-32-bytes-para-firmado

FRONTEND_DOMAIN=http://localhost:4200,https://app.cursala.com.ar
RESET_PASSWORD_FRONTEND_PATH=/reset-password
EXPIRE_TIME_TOKEN_RESET_PASSWORD=30m
EXPIRE_TIME_TOKEN_USER_LOGGED=1d
USER_VALIDATION_PATHNAME=/reset-password

# Correos Institucionales
SUPPORT_EMAIL=support@cursala.com.ar
NO_REPLY_EMAIL=noreply@cursala.com.ar
INFO_EMAIL=info@cursala.com.ar
ADMINISTRATION_EMAIL=administracion@cursala.com.ar

# ===============================================
# BUNNY.NET (CDN & STREAMING)
# ===============================================
BUNNY_STORAGE_API_KEY=tu-bunny-storage-api-key
BUNNY_STORAGE_ZONE_NAME=cursala
BUNNY_STORAGE_REGION=br
BUNNY_STORAGE_CDN_HOSTNAME=https://cursala.b-cdn.net

BUNNY_STREAM_API_KEY=tu-bunny-stream-api-key
BUNNY_STREAM_LIBRARY_ID=549984
BUNNY_STREAM_CDN_HOSTNAME=https://vz-19135c35-e7f.b-cdn.net
BUNNY_STREAM_API_URL=https://video.bunnycdn.com/library/549984/videos

# ===============================================
# CORS (Orígenes habilitados para desarrollo)
# ===============================================
CORS_ORIGINS=http://localhost:4200,http://localhost:3002